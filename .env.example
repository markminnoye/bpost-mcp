# -----------------------------------------------------------------------------
# BPost MCP Environment Variables Template
# -----------------------------------------------------------------------------
# Official MCP URL: ${NEXT_PUBLIC_BASE_URL}/mcp
# Legacy alias (same handler): ${NEXT_PUBLIC_BASE_URL}/api/mcp

# 1. Database (Neon Postgres)
# Vercel automatically prefixes these with BPOST_DB_ if using the integration.
# Locally, you can use DATABASE_URL if you prefer.
BPOST_DB_DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# 2. Security (AES-256-GCM)
# Generate using: openssl rand -base64 32
ENCRYPTION_KEY="your-32-byte-base64-key"

# 3. Authentication (Auth.js / NextAuth v5)
# Generate using: openssl rand -base64 32
AUTH_SECRET="your-random-auth-secret"

# 4. Google OAuth (Dashboard Access)
# Authorized Redirect URI: https://your-domain.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# 5. OAuth 2.0 MCP Integration (JWT Signing)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_JWT_SECRET="generate-a-32-byte-random-secret-here"  # JWT signing (HS256)

# 6. Seeding (Demo Tenant)
# Used only by: npm run seed
SEED_BPOST_USERNAME="bpost-client-id"
SEED_BPOST_PASSWORD="bpost-password"
SEED_BPOST_CUSTOMER_NUMBER="8-digit-prs-id"
SEED_BPOST_ACCOUNT_ID="8-digit-pbc-id"

# 7. Public base URL (Required — no default)
# Local dev:  http://localhost:3000
# Preview:    https://preview.bpost.sonicrocket.app
# Production: https://bpost.sonicrocket.app
# Set this in the Vercel dashboard for Preview and Production environments.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 8. Redis (batch upload / MCP pipeline state)
# Vercel Marketplace Redis links this automatically as REDIS_URL.
# Local: use your Redis provider’s connection string (redis://…).
REDIS_URL=

# 9. Ops probes
# Timeout in milliseconds for /ready dependency probes (DB + Redis).
# Optional; defaults to 1500 when unset.
READINESS_PROBE_TIMEOUT_MS=1500

# 10. GitHub PAT (Optional — for autonomous issue reporting via report_issue MCP tool)
# Scopes required: issues:write on markminnoye/bpost-mcp and markminnoye/bpost-e-masspost-skills
GITHUB_TOKEN=

# 11. Legacy OAuth issuers (optional)
# Comma-separated origins. Access tokens with this iss and aud stay valid after a host move.
# Unset uses the built-in default https://bpost.sonicrocket.io.
# Set to empty to accept only the request host and NEXT_PUBLIC_BASE_URL.
# Preview clients that still hold tokens from preview.bpost.sonicrocket.io can be added here:
# AUTH_ACCEPTED_ISSUERS=https://bpost.sonicrocket.io,https://preview.bpost.sonicrocket.io
# AUTH_ACCEPTED_ISSUERS=

# 12. Contrapunt / masspost library — zie docs/internal/masspost-test-env.md
# BPOST_TEST_USERNAME / BPOST_TEST_PASSWORD = e-MassPost portal login
BPOST_TEST_CUSTOMER_ID="251614"
# Portal "Account Id" (Header/@accountId) — NOT Barcode Id
BPOST_TEST_ACCOUNT_ID="65486"
# Portal "Barcode Id" 210 → five digits for MID generation when genMID=N and you supply midNum
# BPOST_TEST_BARCODE_CUSTOMER_ID="00210"
# Protocolversie VVVV — Contrapunt locked 0200 (MAIL ID v2.00), live Status 100 op 28/09
BPOST_TEST_MID_VERSION="0200"
# Bestandsreferentie (RequestProps/@customerFileRef + bestandsnaam …_REFERENCE_…)
BPOST_TEST_CUSTOMER_FILE_REF="REFERENCE"

# 12. Optioneel — kolom-mapping via Vercel AI Gateway (alleen als de heuristiek needsAi zet)
# Formaat: provider/model. Zonder model blijft dat pad dicht (fail-closed). Geen adresrijen naar het model.
# MASSPOST_SUGGEST_MAPPING_MODEL="openai/gpt-4.1-mini"
# AI_GATEWAY_API_KEY=
